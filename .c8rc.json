{
  "all": true,
  "src": ["src"],
  "include": ["src/lib/**/*.ts", "src/app/api/**/*.ts", "src/middleware.ts"],
  "exclude": ["src/lib/api-client.ts"],
  "extension": [".ts"],
  "reporter": ["text", "text-summary", "html", "lcov", "json-summary"],
  "reports-dir": "coverage",
  "check-coverage": true,
  "lines": 90,
  "branches": 90,
  "functions": 90,
  "statements": 90
}
