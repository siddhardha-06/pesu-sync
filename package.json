{
  "name": "pesu-sync",
  "version": "1.0.0",
  "private": true,
  "description": "PESU-Sync: Campus Events & Capstone Teaming Platform (PostgreSQL + Qdrant + Next.js)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:seed": "tsx db/seed/seed.ts",
    "vector:sync": "tsx scripts/vector-sync.ts",
    "setup": "npm run db:setup && npm run db:seed && npm run vector:sync",
    "test:db": "tsx --test tests/db.test.ts tests/vector.test.ts",
    "test:api": "tsx --test tests/api.test.ts",
    "test": "tsx --test tests/db.test.ts tests/vector.test.ts tests/api.test.ts",
    "test:unit": "node --import tsx --import ./tests/support/register.mjs --test --test-concurrency=1 \"tests/unit/*.test.ts\" \"tests/routes/*.test.ts\"",
    "test:coverage": "npm run db:seed && npm run vector:sync && c8 node --import tsx --import ./tests/support/register.mjs --test --test-concurrency=1 \"tests/unit/*.test.ts\" \"tests/routes/*.test.ts\" tests/db.test.ts tests/vector.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@next/env": "15.5.28",
    "@qdrant/js-client-rest": "1.15.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.13",
    "next": "15.5.28",
    "pg": "^8.16.3",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "c8": "^10.1.3",
    "tailwindcss": "4.1.18",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
