# Copy this file to `.env` and change the secrets.
# `.env` is git-ignored; nothing below is hard-coded in the source.

# ---- PostgreSQL (read by docker-compose AND by the Next.js API layer) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pesu_sync
POSTGRES_USER=pesu
POSTGRES_PASSWORD=change-me-postgres

# ---- Qdrant vector database ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- Authentication (JWT signing secret, at least 32 characters) ----
JWT_SECRET=replace-with-a-long-random-string-of-32+-chars

# ---- Log in with PESU Academy (PESUAuth, https://github.com/pesu-dev/auth) ----
# Hosted instance by pesu-dev. To keep passwords on your own machine, self-host it:
#   docker compose --profile pesu-auth up -d   and set  PESU_AUTH_URL=http://localhost:5000
PESU_AUTH_URL=https://pesuauth.onrender.com

# ---- Campus events (public JSON feed of pes.edu, The Events Calendar REST API) ----
CAMPUS_EVENTS_URL=https://pes.edu/wp-json/tribe/events/v1/events

# ---- Embeddings ----
# local = all-MiniLM-L6-v2 run in Node via transformers.js (downloaded once, ~23 MB)
# hash  = offline feature-hashing fallback (no download, weaker semantics)
EMBEDDING_PROVIDER=local
